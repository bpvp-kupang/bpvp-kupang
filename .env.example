# Salin menjadi .env — JANGAN pernah commit file .env
# MySQL lokal (Docker) atau connection string Neon (gratis)
DATABASE_URL="mysql://root:@localhost:3306/bpvp_kupang"

# Kunci penandatanganan sesi admin — buat dengan: openssl rand -hex 32
SESSION_SECRET="ganti-dengan-random-panjang"

# Dipakai seed untuk password admin awal (WAJIB diganti setelah go-live)
ADMIN_PASSWORD="demo1234"

# URL publik situs (untuk metadata & sitemap)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"